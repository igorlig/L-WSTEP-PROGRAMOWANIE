# Zad 1
paliwo = 100
paliwo_zuzyte_na_s = 10
czas = 0

while paliwo > 0:
    print("Pozostałe paliwo:", paliwo, "l, czas:", czas, "s")
    paliwo -= paliwo_zuzyte_na_s
    czas += 1

print("Koniec lotu.")


# Zad 2
licznik = 0
liczba = 2
wynik = []

while licznik < 10:
    pierwsza = True
    for i in range(2, liczba):
        if liczba % i == 0:
            pierwsza = False
            break
    if pierwsza:
        wynik.append(str(liczba))
        licznik += 1
    liczba += 1

print(",".join(wynik))


