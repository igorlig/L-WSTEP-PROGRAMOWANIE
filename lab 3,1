# Zad 7 A
n = int(input("Podaj liczbę studentów: "))
suma = 0
i = 0

while i < n:
    pkt = float(input("Podaj liczbę punktów: "))
    if pkt < 0 or pkt > 100:
        continue
    suma += pkt
    i += 1

print("Średnia punktów:", suma / n)

# Zad 7 B
